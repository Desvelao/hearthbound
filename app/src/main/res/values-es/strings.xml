    <string name="onboarding_welcome_title">Convierte tu día en un juego</string>
    <string name="onboarding_welcome_text">Completa tus hábitos, tareas diarias y pendientes para ganar XP y oro. Si fallas una tarea diaria, pierdes algo de salud. Todo se queda en tu teléfono: sin cuenta y sin internet.</string>
    <string name="onboarding_language">Idioma</string>
    <string name="onboarding_how_title">Cómo funciona</string>
    <string name="onboarding_how_habits">Toca + por algo bueno y − por algo que quieras reducir. Tantas veces como quieras.</string>
    <string name="onboarding_how_dailies">Se repiten los días que elijas. Hazlas para mantener tu racha, que aumenta tu XP.</string>
    <string name="onboarding_how_todos">Tareas puntuales con fecha límite y lista opcionales.</string>
    <string name="onboarding_how_rewards">Gasta tu oro en caprichos que defines tú.</string>
    <string name="onboarding_how_warning">Si tu salud llega a cero pierdes un nivel y la mitad de tu oro, así que pausa el juego en vacaciones o por enfermedad en Ajustes.</string>
    <string name="onboarding_features_title">Elige tu juego</string>
    <string name="onboarding_features_intro">Son extras. Déjalos activados para el juego completo o desactiva lo que no quieras. Puedes cambiarlos más tarde en Ajustes.</string>
    <string name="onboarding_feature_quests">Misiones de jefe</string>
    <string name="onboarding_feature_quests_text">Las tareas terminadas dañan a un jefe, que se escapa si se acaban los días. Perder uno no te cuesta nada.</string>
    <string name="onboarding_feature_classes">Clases y habilidades</string>
    <string name="onboarding_feature_classes_text">Desde el nivel 10, elige una clase, gasta puntos de estadística y lanza habilidades con maná.</string>
    <string name="onboarding_feature_gear">Bonificaciones de equipo</string>
    <string name="onboarding_feature_gear_text">El equipo de la tienda da pequeñas bonificaciones. Desactivado, es solo de adorno.</string>
