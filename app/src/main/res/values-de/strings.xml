    <string name="app_dialog_questwon_title">Boss besiegt!</string>
    <string name="app_dialog_questwon_text">Deine Aufgaben haben ihn bezwungen. Die Belohnung gehört dir; öffne Belohnungen &gt; Quests, um die Quest abzuschließen.</string>
